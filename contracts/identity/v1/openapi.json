{
  "openapi": "3.0.3",
  "info": {
    "title": "Currency Rates Identity HTTP API",
    "version": "1.0.0",
    "description": "Agreed HTTP contract. Business endpoints are not implemented by the scaffold."
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "operationId": "Register",
        "summary": "Register",
        "security": [],
        "description": "Creates a user without automatically logging in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Register succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                },
                "example": {
                  "userId": "11111111-1111-4111-8111-111111111111",
                  "name": "alice"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "validation_failed"
            ]
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "internal_error"
            ]
          },
          "503": {
            "description": "service_unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "service_unavailable"
            ]
          },
          "409": {
            "description": "username_taken",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "username_taken"
            ]
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "Login",
        "summary": "Login",
        "security": [],
        "description": "Creates a new independent session. Unknown username and wrong password produce the same 401.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "accessToken": "example-token",
                  "tokenType": "Bearer",
                  "expiresAt": "2026-11-10T15:00:00Z",
                  "userId": "11111111-1111-4111-8111-111111111111"
                }
              }
            }
          },
          "400": {
            "description": "validation_failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "validation_failed"
            ]
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "internal_error"
            ]
          },
          "503": {
            "description": "service_unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "service_unavailable"
            ]
          },
          "401": {
            "description": "invalid_credentials",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "invalid_credentials"
            ],
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "example": "Bearer"
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "Logout",
        "summary": "Revoke the current session",
        "description": "Only the current session is revoked. After success, new requests using it fail with 401. Repeating logout with that token also fails with 401. Requests already executing are not interrupted.",
        "responses": {
          "204": {
            "description": "Session revoked; no body."
          },
          "401": {
            "description": "authentication_required, invalid_token, invalid_session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "authentication_required",
              "invalid_token",
              "invalid_session"
            ],
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "example": "Bearer"
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "internal_error"
            ]
          },
          "503": {
            "description": "service_unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "service_unavailable"
            ]
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "RS256; issuer currency-rates-identity; audience currency-rates-api. Default TTL 60 minutes, clock skew 0. Session must be active; current-session logout is immediate."
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string",
            "description": "Safe English message; no exception details or secrets."
          },
          "instance": {
            "type": "string",
            "description": "Request path."
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "example": {
          "type": "about:blank",
          "title": "Conflict",
          "status": 409,
          "detail": "Username is already taken.",
          "instance": "/api/auth/register",
          "code": "username_taken",
          "traceId": "example-trace"
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Trim surrounding whitespace, then require 3..50 ASCII letters, digits, underscore, hyphen or dot. Login and uniqueness are case-insensitive; display case is preserved."
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 12,
            "maxLength": 128,
            "description": "Case and spaces are significant; never trim. No mandatory character classes."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "name",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Trim surrounding whitespace, then require 3..50 ASCII letters, digits, underscore, hyphen or dot. Login and uniqueness are case-insensitive; display case is preserved."
          },
          "password": {
            "type": "string",
            "format": "password",
            "writeOnly": true,
            "minLength": 12,
            "maxLength": 128,
            "description": "Case and spaces are significant; never trim. No mandatory character classes."
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "required": [
          "userId",
          "name"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Non-empty UUID in D format.",
            "not": {
              "enum": [
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          },
          "name": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresAt",
          "userId"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "UTC ISO 8601 timestamp ending in Z."
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Non-empty UUID in D format.",
            "not": {
              "enum": [
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          }
        }
      }
    }
  }
}
